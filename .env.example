# ---------------------------------------------------------------------------
# HANI BARBERSHOP — environment variables
# Copy to .env.local for development. In production set them in Vercel.
# Never commit real values.
# ---------------------------------------------------------------------------

# Public base URL (used in e-mails, sitemap, Open Graph)
SITE_URL=https://www.example.de

# Random secret, min. 32 characters (sessions, rate-limit hashing).
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Database (Supabase PostgreSQL) -----------------------------------------
# Server-only connection string. Use the pooled "Transaction" connection
# (port 6543) from Supabase → Project Settings → Database.
# Leave empty in local development to use the embedded database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Supabase Auth & Storage -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key — safe for the browser, only used for admin sign-in.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — SERVER ONLY (image uploads, scripts/create-admin.ts). Never expose.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- E-mail (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g.  HANI BARBERSHOP <termine@example.de>
EMAIL_FROM=

# --- Local development only ----------------------------------------------------
# Admin password for /admin when Supabase is NOT configured. Ignored in production.
ADMIN_DEV_PASSWORD=
# Print e-mail bodies to the console in development
EMAIL_DEV_LOG=false

# Set to true once Impressum & Datenschutz have been reviewed (hides the draft notice)
LEGAL_TEXTS_REVIEWED=false
